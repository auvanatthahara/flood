POSTGRES_DB=flood
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

DATABASE_URL=postgresql://your_username:your_password@localhost:5434/flood

# Not read by Airflow — it generates and persists its own admin password in
# the airflow_data volume (/opt/airflow/simple_auth_manager_passwords.json.generated).
# Copy the generated value here for your own reference.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=your_admin_password